DATABASE_URL="postgresql://bloom:bloom@127.0.0.1:55432/postgres?connection_limit=1&pgbouncer=true"
APP_URL="http://127.0.0.1:3000"
AUTH_SECRET="replace-with-a-random-secret-at-least-32-characters"
DATA_SECRET="replace-with-a-different-random-secret-at-least-32-characters"
COOKIE_SECURE="false"
DEMO_SEED="true"
# Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client IDs.
# Use a Web application client. Register the APP_URL callback for ordinary sign-in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Resend Dashboard > API Keys. Use a sending key for a verified domain.
RESEND_API_KEY=
# Sender address on that domain, from Resend Dashboard > Domains.
PASSWORD_RESET_FROM=
# Optional notification sender address. Falls back to PASSWORD_RESET_FROM.
NOTIFICATION_EMAIL_FROM=
# Twilio Console > Account Info. Use live credentials for the test account.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Twilio Console > Verify > Services. Copy the Service SID.
TWILIO_VERIFY_SERVICE_SID=
# Twilio Console > Messaging > Services, or an SMS-capable Twilio number.
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_FROM_NUMBER=
# Twilio Console > WhatsApp senders. Use a sender enabled for WhatsApp.
TWILIO_WHATSAPP_FROM=
# Set to TWILIO or META to select the WhatsApp sender integration.
WHATSAPP_PROVIDER=
# Meta for Developers > WhatsApp > API Setup. Use a permanent token in production.
META_WHATSAPP_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_GRAPH_API_VERSION=
# Optional local-only verification code, ignored by production builds.
# OTP_DEV_CODE=123456
# First administrator for a live database. Unset after bootstrapping.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Set only when your hosting proxy strips and replaces this header.
TRUSTED_CLIENT_IP_HEADER=

# Razorpay Dashboard > API Keys. Use test-mode keys for local checkout and live smoke.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Razorpay Dashboard > Webhooks, for /api/webhooks/razorpay.
# Subscribe to payment.captured, payment.failed, and refund.processed.
RAZORPAY_WEBHOOK_SECRET=

# Optional preview socket port for npm run db:local.
# LOCAL_DB_PORT=55432
# Export a migrated, disposable native PostgreSQL URL in your shell to run the concurrency test.
# TEST_DATABASE_URL=

# Optional live smoke checks. Use a disposable native local PostgreSQL database,
# separate from DATABASE_URL. Supply its connection URL with a migration-capable role.
SMOKE_DATABASE_URL=
# Local runner origin. Register this exact origin plus /api/auth/google-callback in Google Cloud.
SMOKE_APP_URL="http://127.0.0.1:3014"
# Google account you control. Add it as a test user on the Google consent screen when required.
SMOKE_GOOGLE_EMAIL=
# SMS-capable test number you control in E.164 format. Verify it in Twilio Console for a trial account.
SMOKE_TWILIO_PHONE=
# Inbox you control and an address not already present in the smoke database.
SMOKE_RESEND_EMAIL=
# Razorpay smoke: use a fresh Customer email and password in your test account database.
# The runner creates this account and a booking; complete its test checkout in the browser.
SMOKE_RAZORPAY_EMAIL=
SMOKE_RAZORPAY_PASSWORD=
# SMS reminder smoke: an SMS-capable number you control in E.164 format.
SMOKE_REMINDER_PHONE=
