{
  "name": "bloom-and-blush",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "^22.13.0 || >=24"
  },
  "scripts": {
    "predev": "prisma generate",
    "dev": "next dev --hostname 127.0.0.1",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "prisma generate && tsc --noEmit",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm test",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "node --env-file-if-exists=.env --import tsx prisma/seed.ts",
    "db:local": "node scripts/local-db.mjs",
    "jobs:run": "node --env-file-if-exists=.env --import tsx scripts/jobs.ts",
    "jobs:work": "npm run jobs:run -- --watch",
    "test": "node --import tsx --test tests/*.test.ts tests/*.test.mjs",
    "smoke:live": "node --env-file-if-exists=.env scripts/smoke-live.mjs",
    "postinstall": "prisma generate",
    "prepare": "husky"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.2.0",
    "@fontsource-variable/playfair-display": "^5.2.0",
    "@js-temporal/polyfill": "^0.5.1",
    "@prisma/client": "^6.19.3",
    "@radix-ui/react-slot": "^1.2.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "google-auth-library": "^10.5.0",
    "jose": "^6.1.3",
    "lucide-react": "^0.577.0",
    "next": "^16.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.3.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.0",
    "@electric-sql/pglite-socket": "^0.2.0",
    "@eslint-react/eslint-plugin": "^5.30.5",
    "@eslint/js": "^10.0.0",
    "@next/eslint-plugin-next": "16.4.6",
    "@tailwindcss/postcss": "^4.2.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.6.2",
    "prisma": "^6.19.3",
    "tailwindcss": "^4.2.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.73.0"
  }
}
